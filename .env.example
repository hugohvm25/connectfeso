# Chaves de API (Template - Não coloque suas chaves reais aqui!)
# Copie este arquivo e renomeie para .env, então preencha os valores reais.

GOOGLE_MAPS_API_KEY=COLE_SUA_CHAVE_AQUI
GEMINI_API_KEY=COLE_SUA_CHAVE_AQUI

# Configurações do Firebase
FIREBASE_ANDROID_API_KEY=COLE_SUA_CHAVE_AQUI
FIREBASE_IOS_API_KEY=COLE_SUA_CHAVE_AQUI

# Configuração do Modelo do Chat (gemini-1.5-flash ou gemini-2.0-flash)
GEMINI_MODEL=gemini-1.5-flash
